# ──────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────
# Elasticsearch
# ──────────────────────────────────────────────────────────
ES_HOST=http://elasticsearch:9200
ES_INDEX=documents200

# If you enable auth:
ES_USERNAME=
ES_PASSWORD=

# ──────────────────────────────────────────────────────────
# Chunking (not in Settings)
# ──────────────────────────────────────────────────────────
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# ──────────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20
CHAT_TTL_SECONDS=7200         # 2 hours
CHAT_MAX_HISTORY_TURNS=5
JOB_TTL_SECONDS=86400         # 24 hours

# ──────────────────────────────────────────────────────────
# RabbitMQ / Celery
# ──────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIMEOUT=300

# ──────────────────────────────────────────────────────────
# Embedding Model
# ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=qwen3-embedding:4b # text-embedding-3-small | qwen3-embedding:4b
EMBEDDING_PROVIDER=ollama           # ollama | openai

# ──────────────────────────────────────────────────────────
# LLM / Ollama / OpenAI
# ──────────────────────────────────────────────────────────
LLM_PROVIDER=openai           # ollama | openai
OLLAMA_BASE_URL=http://ollama:11434 # http://ollama:11434
LLM_MODEL=gpt-4o-mini  # llama3.1:8b | gpt-4o-mini

# OpenAI:
OPENAI_API_KEY=
OPENAI_BASE_URL=

LLM_TEMPERATURE=0.8

# ──────────────────────────────────────────────────────────
# Retrieval
# ──────────────────────────────────────────────────────────
RERANK_TOP_N=3
RETRIEVAL_TOP_K=15
KNN_NUM_CANDIDATES=100

# ──────────────────────────────────────────────────────────
# File upload
# ──────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=52428800     # 50 MB
UPLOAD_TMP_DIR=/tmp/rag_uploads